# Google Sheets
GOOGLE_SHEETS_SPREADSHEET_ID=${{ secrets.GOOGLE_SHEETS_SPREADSHEET_ID }}

# Firebase Core
FIREBASE_PROJECT_ID=${{ secrets.FIREBASE_PROJECT_ID }}
FIREBASE_AUTH_DOMAIN=${{ secrets.FIREBASE_AUTH_DOMAIN }}
FIREBASE_STORAGE_BUCKET=${{ secrets.FIREBASE_STORAGE_BUCKET }}
FIREBASE_MESSAGING_SENDER_ID=${{ secrets.FIREBASE_MESSAGING_SENDER_ID }}
FIREBASE_MEASUREMENT_ID=${{ secrets.FIREBASE_MEASUREMENT_ID }}
FIREBASE_FUNCTIONS_REGION=us-central1

# Firebase Web
FIREBASE_WEB_API_KEY=${{ secrets.FIREBASE_WEB_API_KEY }}
FIREBASE_WEB_APP_ID=${{ secrets.FIREBASE_WEB_APP_ID }}

# Firebase Android
FIREBASE_ANDROID_API_KEY=${{ secrets.FIREBASE_ANDROID_API_KEY }}
FIREBASE_ANDROID_APP_ID=${{ secrets.FIREBASE_ANDROID_APP_ID }}

# Firebase iOS / macOS
FIREBASE_IOS_API_KEY=${{ secrets.FIREBASE_IOS_API_KEY }}
FIREBASE_IOS_APP_ID=${{ secrets.FIREBASE_IOS_APP_ID }}
FIREBASE_IOS_BUNDLE_ID=${{ secrets.FIREBASE_IOS_BUNDLE_ID }}
FIREBASE_MACOS_BUNDLE_ID=${{ secrets.FIREBASE_MACOS_BUNDLE_ID }}

# Google Maps (from previous config)
GOOGLE_MAPS_API_KEY_ANDROID=${{ secrets.GOOGLE_MAPS_API_KEY_ANDROID }}
GOOGLE_MAPS_API_KEY_IOS=${{ secrets.GOOGLE_MAPS_API_KEY_IOS }}
GOOGLE_MAPS_API_KEY_WEB=${{ secrets.GOOGLE_MAPS_API_KEY_WEB }}

# Other Services
GOOGLE_SERVICE_ACCOUNT_EMAIL=${{ secrets.GOOGLE_SERVICE_ACCOUNT_EMAIL }}

# App Settings
APP_FLAVOR=prod
APP_VERSION=${{ github.ref_name }}
FIRESTORE_REPORTS_COLLECTION=reports
FIRESTORE_USERS_COLLECTION=users
FIRESTORE_TEAMS_COLLECTION=teams
FIRESTORE_AUDIT_LOGS_COLLECTION=audit_logs

# Feature Flags
ENABLE_MAPS=true
ENABLE_OFFLINE_MODE=true
ENABLE_CRASH_REPORTING=true
ENABLE_ANALYTICS=true

# Timeouts & Intervals
SESSION_TIMEOUT_SECONDS=3600
SYNC_INTERVAL_SECONDS=30
API_TIMEOUT_SECONDS=15
# Protect your own account from admin-side edits in the control center.
# Set one or both values below:
PRIMARY_ACCOUNT_UID=
PRIMARY_ACCOUNT_EMAIL=