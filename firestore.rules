rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null && !(
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.isDeleted == true
      );
    }

    function roleFor(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && roleFor(request.auth.uid) == 'admin';
    }

    function isManager() {
      return isSignedIn() && roleFor(request.auth.uid) == 'manager';
    }

    function isAdminOrManager() {
      return isAdmin() || isManager();
    }

    function canManagerModifyUser(userId) {
      return isManager()
        && userId != request.auth.uid
        && !(
          get(/databases/$(database)/documents/users/$(userId)).data.role
            in ['manager', 'admin']
        );
    }

    function managerCanAssignRole() {
      return request.resource.data.role in ['employee', 'manager'];
    }

    function canManagerDeleteUser(userId) {
      return isManager()
        && userId != request.auth.uid
        && get(/databases/$(database)/documents/users/$(userId)).data.role
            == 'employee';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasArchiveAccess() {
      let allowedReports = get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.allowedReports;
      return isSignedIn()
        && allowedReports is list
        && 'reports_archive' in allowedReports;
    }

    function canCreateReportType(reportType) {
      let allowedReports = get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.allowedReports;
      return isSignedIn()
        && allowedReports is list
        && (
          (reportType == 'R0' && 'r0_report' in allowedReports)
          || (reportType == 'Activity TNB' && 'activity_report' in allowedReports)
          || ((reportType == 'daily TSUD' || reportType == 'Daily TSUD')
              && 'daily_report' in allowedReports)
          || ((reportType == 'Suivi Camion'
                || reportType == 'Chargeuse'
                || reportType == 'Pelle')
              && 'truck_tracking' in allowedReports)
          || (reportType == 'Machine/Engin Arrêtés'
              && 'machines_stopped' in allowedReports)
        );
    }
    
    function canUseReportAccessKey(reportAccessKey) {
      let allowedReports = get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.allowedReports;
      return isSignedIn()
        && allowedReports is list
        && reportAccessKey is string
        && reportAccessKey in allowedReports;
    }

    function canReadReportByAccess(docData) {
      return canUseReportAccessKey(docData.reportAccessKey)
        || canCreateReportType(docData.type);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdminOrManager();
      allow create: if isOwner(userId)
        || isAdmin()
        || (canManagerModifyUser(userId) && managerCanAssignRole());
      allow update: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.role == resource.data.role
      ) || (
        canManagerModifyUser(userId)
        && managerCanAssignRole()
        && request.resource.data.role != 'admin'
      );
      allow delete: if isAdmin() || canManagerDeleteUser(userId);
    }

    match /report_definitions/{reportKey} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdminOrManager();
    }

    match /reports/{reportId} {
      allow read: if isOwner(resource.data.userId)
        || isAdmin()
        || isManager()
        || (hasArchiveAccess() && canReadReportByAccess(resource.data));
      allow create: if isOwner(request.resource.data.userId)
        && (
          isAdmin()
          || canUseReportAccessKey(request.resource.data.reportAccessKey)
          || canCreateReportType(request.resource.data.type)
        );
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }
  }
}